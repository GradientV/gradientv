{
    "name": "gradientv-site",
    "version": "2.0.0",
    "description": "gradientv.com. React + Tailwind client, and an Express + MongoDB server for the client portal.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev": "concurrently --names server,client --prefix-colors blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
        "build": "npm run build -w client",
        "preview": "npm run preview -w client",
        "add-client": "npm run add-client -w server --",
        "site-key": "npm run site-key -w server --",
        "import-site-data": "npm run import-site-data -w server --",
        "check-analytics": "npm run check-analytics -w server --",
        "indexnow": "npm run indexnow -w client"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
